# Galaxy Bay - Environment Variables Example
# Copie este arquivo para .env e preencha com seus valores

# ==============================================
# BACKEND
# ==============================================

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/galaxy_bay?schema=public"

# JWT
JWT_SECRET="seu-secret-super-seguro-aqui-mude-isso"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3001"

# Blockchain
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR-API-KEY"
NFT_CONTRACT_ADDRESS="0x..."
MARKETPLACE_CONTRACT_ADDRESS="0x..."

# IPFS / NFT.Storage
NFT_STORAGE_API_KEY="your-nft-storage-api-key"

# Storage (local ou S3)
STORAGE_TYPE="local"
STORAGE_PATH="../storage"

# Optional: AWS S3 (se usar S3 em vez de local)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET=""

# Optional: Sentry (monitoring)
# SENTRY_DSN=""

# ==============================================
# FRONTEND
# ==============================================

# API
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
NEXT_PUBLIC_FRONTEND_URL="http://localhost:3001"

# Blockchain
NEXT_PUBLIC_CHAIN_ID="11155111"
NEXT_PUBLIC_CHAIN_NAME="Sepolia"
NEXT_PUBLIC_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR-API-KEY"
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS="0x..."
NEXT_PUBLIC_MARKETPLACE_CONTRACT_ADDRESS="0x..."

# Features
NEXT_PUBLIC_ENABLE_ANALYTICS="false"
NEXT_PUBLIC_ENABLE_SENTRY="false"

# Optional: Sentry (monitoring)
# NEXT_PUBLIC_SENTRY_DSN=""

# ==============================================
# CONTRACTS (Hardhat)
# ==============================================

# Private key para deploy (NUNCA commite isso!)
# Use uma carteira de teste com ETH de faucet
PRIVATE_KEY="sua-private-key-aqui-NUNCA-COMMITE"

# RPC URLs
SEPOLIA_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR-API-KEY"

# Etherscan (para verificação de contratos)
ETHERSCAN_API_KEY="your-etherscan-api-key"

# ==============================================
# NOTAS
# ==============================================

# 1. Nunca commite o arquivo .env real
# 2. Use .env.local para desenvolvimento local
# 3. Use variáveis de ambiente do servidor em produção
# 4. Gere JWT_SECRET forte: openssl rand -base64 32
# 5. Para Sepolia RPC, crie conta gratuita em alchemy.com ou infura.io
# 6. Para NFT.Storage API key, crie conta em nft.storage
