# ==================================================
# DATABASE
# ==================================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/galaxy_bay"

# ==================================================
# SECURITY
# ==================================================
# JWT Secret - Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"

# ==================================================
# IPFS / PINATA STORAGE
# ==================================================
# Como obter credenciais Pinata:
# 1. Criar conta em https://app.pinata.cloud/
# 2. Dashboard → API Keys → "New Key" → Copiar JWT
# 3. Dashboard → Gateways → Copiar domínio do gateway dedicado
#
# Free tier: 1GB storage, 100GB bandwidth/mês
# Plano recomendado para produção: Picnic ($20/mês) - 1TB storage

# JWT da API Pinata (CRÍTICO: Nunca commitar!)
PINATA_JWT="your_pinata_jwt_here"

# Gateway dedicado Pinata (formato: seu-projeto.mypinata.cloud)
PINATA_GATEWAY="your-gateway.mypinata.cloud"

# NFT.Storage (DEPRECADO - descontinuado em junho/2024)
# Manter temporariamente para migração de dados existentes
# NFT_STORAGE_KEY="your-nft-storage-key-here"

# ==================================================
# BLOCKCHAIN - SEPOLIA TESTNET
# ==================================================
# Alchemy: https://www.alchemy.com/
# Infura: https://www.infura.io/
RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY"

# Smart Contract Addresses (deployed on Sepolia)
NFT_CONTRACT_ADDRESS="0x4613a374097Ab5DB0bc47DA2725fC4eE285F3f21"
MARKETPLACE_CONTRACT_ADDRESS="0x477b3ab5F17AecD7Ca5c189FC902CF05397eCED1"

# ==================================================
# APPLICATION
# ==================================================
NODE_ENV="development"
PORT=3000

# ==================================================
# CORS
# ==================================================
FRONTEND_URL="http://localhost:3001"

# ==================================================
# OPTIONAL
# ==================================================
LOG_LEVEL="debug"
